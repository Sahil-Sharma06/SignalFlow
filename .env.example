# Copy to .env.local. Everything is optional: with no keys the app runs fully offline on mock AI.

# ---- AI provider -----------------------------------------------------------
# gemini (default) | groq | ollama | mock
# If the selected provider has no key / is unreachable, every call falls back to deterministic mocks.
AI_PROVIDER=gemini

# Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local): `ollama pull llama3.1`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Sending -----------------------------------------------------------------
# dry-run (default): emails are marked sent and opens/clicks are simulated. Nothing leaves your machine.
# resend: real sends via Resend. Requires RESEND_API_KEY. Seed contacts are fictional, so by default
# every real send is redirected to RESEND_TEST_TO.
SEND_MODE=dry-run
RESEND_API_KEY=
RESEND_FROM=Alex <alex@outreach.yourdomain.com>
RESEND_TEST_TO=you@example.com
RESEND_ALLOW_REAL_RECIPIENTS=false

# ---- Signals -----------------------------------------------------------------
# Optional RSS feed (e.g. a news-search feed). Items that name a known company become signals.
SIGNAL_RSS_URL=

# ---- Storage -----------------------------------------------------------------
DATABASE_PATH=./data/signalflow.db
